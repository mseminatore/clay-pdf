// PdfImage -- an image to draw on pages: from PNG or JPEG file data, or raw pixels
//
//   img = doc loadImage("photo.jpg")            // .png, .jpg or .jpeg
//   img = doc png(bytes)  /  doc jpeg(bytes)    // file data as a String
//   img = doc image(w, h, channels, pixels)     // 8-bit pixels, row by row
//   page image(img, x, y, w, h)
//
// PNG and JPEG data goes into the PDF as it is, still compressed: JPEG as
// DCTDecode, PNG's zlib data as FlateDecode with the PNG row predictors (so
// nothing is decoded here). That covers gray, RGB and palette PNGs that are
// not interlaced; a PNG with an alpha channel has to be decoded first, so
// for those use raw pixels. Raw pixels are stored uncompressed; with 2 or 4
// channels the last is alpha and becomes a soft mask. Any gray image can be
// a mask: rgb mask(alpha).

PdfImage = Object clone {
    init(w, h, dict, data) {
        self _w = w
        self _h = h
        self _dict = dict    // the stream dictionary's entries, without /Length
        self _data = data
        self _mask = nil
        self _gray = false
        self
    }

    width() { _w }
    height() { _h }

    // Use a gray image of the same size as this one's alpha (soft mask)
    mask(alpha) {
        (alpha == nil) ifTrue { self _mask = nil; return self }
        (alpha _gray) ifFalse { raise("Pdf: a mask must be a gray image") }
        ((alpha width != _w) || (alpha height != _h)) ifTrue { raise("Pdf: a mask must be the image's size") }
        self _mask = alpha
        self
    }

    // ---- making images ------------------------------------------------------

    // From raw 8-bit pixels: channels 1 gray, 2 gray + alpha, 3 RGB, 4 RGBA
    raw(w, h, channels, pixels) {
        ((channels < 1) || (channels > 4)) ifTrue { raise("Pdf: an image has 1 to 4 channels, not " + channels toString) }
        (pixels length != w * h * channels) ifTrue {
            raise("Pdf: expected " + (w * h * channels) toString + " bytes of pixels, got " + pixels length toString)
        }
        (channels == 1) ifTrue { return PdfImage _plain(w, h, 1, pixels) }
        (channels == 3) ifTrue { return PdfImage _plain(w, h, 3, pixels) }
        parts = PdfImage splitAlpha(pixels, channels)
        img = PdfImage _plain(w, h, channels - 1, parts at(0))
        (parts at(1) != nil) ifTrue { img mask(PdfImage _plain(w, h, 1, parts at(1))) }
        img
    }

    // Pixels with an alpha channel (2 or 4 channels) as [color, alpha]: the
    // color bytes (1 or 3 channels) and the alpha bytes, or nil for alpha
    // when every pixel is opaque
    splitAlpha(pixels, channels) {
        ((channels != 2) && (channels != 4)) ifTrue { raise("Pdf: splitAlpha expects 2 or 4 channels") }
        b = pixels bytes
        color = []
        alpha = []
        opaque = true
        i = 0
        m = b size
        (channels == 4) ifTrue {
            { i < m } whileTrue {
                color push(b at(i)); color push(b at(i + 1)); color push(b at(i + 2))
                a = b at(i + 3)
                alpha push(a)
                (a != 255) ifTrue { opaque = false }
                i = i + 4
            }
        } ifFalse {
            { i < m } whileTrue {
                color push(b at(i))
                a = b at(i + 1)
                alpha push(a)
                (a != 255) ifTrue { opaque = false }
                i = i + 2
            }
        }
        [String fromBytes(color), opaque ifTrue { nil } ifFalse { String fromBytes(alpha) }]
    }

    // From a PNG file's bytes (gray, RGB or palette; not interlaced, no alpha)
    png(data) {
        sig = [137, 80, 78, 71, 13, 10, 26, 10]
        ok = data length > 8
        ok ifTrue { 8 times { |i| (data byteAt(i) != sig at(i)) ifTrue { ok = false } } }
        ok ifFalse { raise("Pdf: not a PNG file") }
        w = nil
        h = nil
        depth = 8
        ctype = 0
        palette = nil
        idat = []
        pos = 8
        n = data length
        done = false
        { (pos + 8 <= n) && (done == false) } whileTrue {
            len = PdfImage _u32(data, pos)
            kind = data slice(pos + 4, pos + 8)
            start = pos + 8
            (start + len > n) ifTrue { raise("Pdf: truncated PNG") }
            (kind == "IHDR") ifTrue {
                w = PdfImage _u32(data, start)
                h = PdfImage _u32(data, start + 4)
                depth = data byteAt(start + 8)
                ctype = data byteAt(start + 9)
                (data byteAt(start + 12) != 0) ifTrue { raise("Pdf: interlaced PNGs are not supported") }
            }
            (kind == "PLTE") ifTrue { palette = data slice(start, start + len) }
            (kind == "IDAT") ifTrue { idat push(data slice(start, start + len)) }
            (kind == "IEND") ifTrue { done = true }
            pos = start + len + 4   // skip the CRC
        }
        (w == nil) ifTrue { raise("Pdf: PNG has no header") }
        ((ctype == 4) || (ctype == 6)) ifTrue {
            raise("Pdf: PNGs with an alpha channel need decoding: draw their pixels with doc image(w, h, channels, pixels)")
        }
        colors = (ctype == 2) ifTrue { 3 } ifFalse { 1 }
        space = (ctype == 2) ifTrue { "/DeviceRGB" } ifFalse { "/DeviceGray" }
        (ctype == 3) ifTrue {
            (palette == nil) ifTrue { raise("Pdf: palette PNG has no palette") }
            space = "[/Indexed /DeviceRGB " + ((palette length / 3) - 1) toString + " " + (Pdf string(palette)) + "]"
        }
        dict = "/Type /XObject /Subtype /Image /Width " + w toString + " /Height " + h toString +
            " /ColorSpace " + space + " /BitsPerComponent " + depth toString +
            " /Filter /FlateDecode /DecodeParms << /Predictor 15 /Colors " + colors toString +
            " /BitsPerComponent " + depth toString + " /Columns " + w toString + " >>"
        img = PdfImage new(w, h, dict, idat join(""))
        img _gray = (ctype == 0)
        img
    }

    // From a JPEG file's bytes (gray, RGB or CMYK)
    jpeg(data) {
        ((data length < 4) || (data byteAt(0) != 255) || (data byteAt(1) != 216)) ifTrue { raise("Pdf: not a JPEG file") }
        pos = 2
        n = data length
        { pos + 4 <= n } whileTrue {
            (data byteAt(pos) != 255) ifTrue { raise("Pdf: bad JPEG marker") }
            m = data byteAt(pos + 1)
            // fill bytes (FF FF ...) before a marker
            { (m == 255) && (pos + 5 <= n) } whileTrue { pos = pos + 1; m = data byteAt(pos + 1) }
            len = (data byteAt(pos + 2)) * 256 + data byteAt(pos + 3)
            // start-of-frame markers (not DHT C4, JPG C8, DAC CC)
            sof = (m >= 192) && (m <= 207) && (m != 196) && (m != 200) && (m != 204)
            sof ifTrue {
                h = (data byteAt(pos + 5)) * 256 + data byteAt(pos + 6)
                w = (data byteAt(pos + 7)) * 256 + data byteAt(pos + 8)
                comps = data byteAt(pos + 9)
                space = "/DeviceGray"
                extra = ""
                (comps == 3) ifTrue { space = "/DeviceRGB" }
                (comps == 4) ifTrue { space = "/DeviceCMYK"; extra = " /Decode [1 0 1 0 1 0 1 0]" }
                dict = "/Type /XObject /Subtype /Image /Width " + w toString + " /Height " + h toString +
                    " /ColorSpace " + space + " /BitsPerComponent 8 /Filter /DCTDecode" + extra
                img = PdfImage new(w, h, dict, data)
                img _gray = (comps == 1)
                return img
            }
            pos = pos + 2 + len
        }
        raise("Pdf: JPEG has no frame header")
    }

    _plain(w, h, channels, pixels) {
        space = (channels == 1) ifTrue { "/DeviceGray" } ifFalse { "/DeviceRGB" }
        img = PdfImage new(w, h, "/Type /XObject /Subtype /Image /Width " + w toString + " /Height " + h toString +
            " /ColorSpace " + space + " /BitsPerComponent 8", pixels)
        img _gray = (channels == 1)
        img
    }

    _u32(s, i) {
        (((s byteAt(i)) * 256 + s byteAt(i + 1)) * 256 + s byteAt(i + 2)) * 256 + s byteAt(i + 3)
    }
}
